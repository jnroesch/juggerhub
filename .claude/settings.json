{
  "permissions": {
    "allow": [],
    "deny": [
      "Read(./.env)",
      "Read(./**/.env)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/*.pfx)",
      "Read(./**/*.p12)",
      "Read(./**/*.crt)",
      "Read(./secrets/**)",
      "Read(./.secrets)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/AppData/Roaming/Microsoft/UserSecrets/**)"
    ]
  },
  "hooks": {
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/worktree-create-with-env.js\"",
            "statusMessage": "Creating worktree and seeding .env"
          }
        ]
      }
    ]
  }
}
