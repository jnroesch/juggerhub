# nginx config for the JuggerHub `web` container image.
#
# The browser only ever talks to this origin. nginx serves the built Angular SPA
# and reverse-proxies /api/ to the backend container, so the app and API are
# same-origin. That keeps httpOnly auth cookies first-party (SameSite=Strict)
# with no CORS. The Angular app always calls relative /api/v1/... URLs.
#
# THIS IS A TEMPLATE, not a finished config (feature 033). The nginx image's own
# /docker-entrypoint.d/20-envsubst-on-templates.sh renders it into
# /etc/nginx/conf.d/default.conf at CONTAINER START, so one built image serves every
# environment. We add no shell script of our own (constitution VI).
#
# Every placeholder here is ${JH_...}. envsubst substitutes any name present in the
# environment, so an unprefixed placeholder could collide with an nginx runtime
# variable ($host, $uri, $scheme, ...) and silently corrupt this file. The prefix makes
# that impossible rather than merely unlikely.

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Don't leak the nginx version in error pages / headers.
    server_tokens off;

    # Proxy API calls to the backend service on the compose network.
    location /api/ {
        proxy_pass http://backend:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Real-time notifications hub (feature 010) — same backend, but the SignalR
    # WebSocket handshake needs the Upgrade/Connection headers to switch protocols.
    location /hubs/ {
        proxy_pass http://backend:8080;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Long-lived connection: don't cut idle sockets early.
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # --- Self-hosted analytics (feature 033) --------------------------------
    # Same-origin on purpose: a tracker served from our own hostname, at a name no
    # general blocklist rule can match, is what keeps the numbers broadly complete.
    # No token from the blocked-name list (analytics, track, stat, collect, beacon,
    # pixel, umami, ...) appears in any URL the browser requests.
    #
    # nginx does the renaming; the UPSTREAM paths are Umami's real, unrenamed ones:
    #   /jh-insights.js -> /script.js   TRACKER_SCRIPT_NAME has NO effect in the image
    #   /jh-insights/e  -> /api/send    COLLECT_API_ENDPOINT only rewrites script.js's
    #                                   contents; it creates no server route
    # Both verified empirically — the documentation implies otherwise. A mismatch here
    # 404s a fire-and-forget beacon: no error anyone sees, just missing data.
    #
    # Exact-match (=) so the `location /` SPA fallback below cannot shadow them.
    #
    # The upstream is reached through a VARIABLE, not a literal, and that is load-bearing.
    # nginx resolves a literal proxy_pass host at STARTUP and refuses to start if it does
    # not exist ("host not found in upstream") — so a literal here would mean the frontend
    # cannot boot whenever Umami is absent. That breaks the default local stack outright,
    # where analytics is off and no `umami` container exists (FR-019), and in-cluster it
    # would let a missing analytics Service take down the entire application. Analytics
    # must never be able to do that (constitution VII). Routing through a variable defers
    # resolution to request time, which needs an explicit resolver.
    resolver ${JH_ANALYTICS_RESOLVER} valid=30s ipv6=off;

    location = /jh-insights.js {
        set $jh_upstream "${JH_ANALYTICS_UPSTREAM}";
        proxy_pass $jh_upstream/script.js;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        # Constitution VII: analytics must never be able to take the app down. Short
        # timeouts so a wedged Umami cannot tie up frontend worker connections, and no
        # retry — re-sending a dropped beacon is exactly the amplification VII prohibits.
        proxy_connect_timeout 2s;
        proxy_send_timeout 3s;
        proxy_read_timeout 3s;
        proxy_next_upstream off;
    }

    location = /jh-insights/e {
        set $jh_upstream "${JH_ANALYTICS_UPSTREAM}";
        proxy_pass $jh_upstream/api/send;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        # Umami derives country and its rotating session hash from the client address;
        # without this every visit looks like it came from the nginx pod. It does not
        # store the address itself (FR-005, verified in T037).
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 2s;
        proxy_send_timeout 3s;
        proxy_read_timeout 3s;
        proxy_next_upstream off;
    }

    # SPA fallback: serve index.html for client-side routes.
    location / {
        try_files $uri $uri/ /index.html;

        # Inject the tracker into <head> at request time (feature 033), so the SAME built
        # image carries different analytics config per environment with no rebuild and no
        # Angular source change (FR-020).
        #
        # When JH_ANALYTICS_HEAD is empty this replaces '</head>' with '</head>' — a no-op.
        # That is why ANALYTICS-OFF IS THE DEFAULT with no conditional config anywhere.
        #
        # sub_filter_types defaults to text/html, which is exactly what we want: the SPA's
        # JS bundles must not be scanned.
        sub_filter '</head>' '${JH_ANALYTICS_HEAD}</head>';
        sub_filter_once on;
    }
}
