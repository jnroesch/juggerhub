<Project Sdk="Microsoft.NET.Sdk">

  <!-- TargetFramework / Nullable / ImplicitUsings are inherited from
       backend/Directory.Build.props. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.0.1" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <!-- Transitive via Testcontainers, which still pins 2025.1.0 — vulnerable to
         GHSA-q939-rpr3-3284 (ScpClient recursive download writes arbitrary files
         from server-controlled names). Patched in 2026.0.0; drop this direct
         reference once Testcontainers ships a build that requires it. -->
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
    <PackageReference Include="Testcontainers.Azurite" Version="4.15.0" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.15.0" />
    <PackageReference Include="Testcontainers.Redis" Version="4.15.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\JuggerHub.Api.csproj" />
  </ItemGroup>

  <!-- Feature 050: real Tugeny responses (MIT-licensed open data, captured 2026-09-15; the same
       files as specs/050-tournament-results/contracts/tugeny-samples). Tests serve them from a
       scripted handler — no test ever calls the real tugeny.org. -->
  <ItemGroup>
    <None Include="Results\Fixtures\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>