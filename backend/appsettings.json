{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Jwt": {
    "Issuer": "",
    "Audience": "",
    "SigningKey": "",
    "AccessTokenLifetimeMinutes": 15
  },
  "Email": {
    "Provider": "Smtp",
    "FromAddress": "",
    "SmtpHost": "",
    "SmtpPort": 1025,
    "FrontendBaseUrl": "",
    "Resend": {
      "ApiKey": ""
    }
  },
  "Admin": {
    "Emails": ""
  },
  "ImageProcessing": {
    "MaxInputBytes": 8388608,
    "MaxDecodePixels": 40000000,
    "AllowedContentTypes": [ "image/png", "image/jpeg", "image/webp" ],
    "Avatar": {
      "ResizeMode": "SquareCrop",
      "MaxDimension": 512,
      "Quality": 80,
      "MaxOutputBytes": 524288
    },
    "Icon": {
      "ResizeMode": "Fit",
      "MaxDimension": 256,
      "Quality": 80,
      "MaxOutputBytes": 131072
    }
  },
  "Resilience": {
    "Outbound": {
      "Resend": {
        "AttemptTimeoutSeconds": 10,
        "TotalTimeoutSeconds": 30,
        "MaxRetryAttempts": 3,
        "BaseDelaySeconds": 2,
        "BreakerFailureRatio": 0.1,
        "BreakerMinimumThroughput": 5,
        "BreakerSamplingSeconds": 60,
        "BreakerDurationSeconds": 30
      }
    }
  }
}
