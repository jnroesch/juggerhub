<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- TargetFramework / Nullable / ImplicitUsings are inherited from
       backend/Directory.Build.props. -->
  <PropertyGroup>
    <RootNamespace>JuggerHub</RootNamespace>
    <AssemblyName>JuggerHub.Api</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <!-- The test project lives under backend/tests/; keep it out of the API
       project's default **/*.cs glob (and out of the runtime image). -->
  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
    <Content Remove="tests/**" />
    <None Remove="tests/**" />
    <EmbeddedResource Remove="tests/**" />
  </ItemGroup>

  <!-- Transactional-email HTML templates are read from the content root at runtime
       (EmailTemplateService). Mark them as published content so the runtime image /
       deployment has them, not just a source checkout. Remove-then-include avoids a
       duplicate with the SDK's default content glob. -->
  <ItemGroup>
    <Content Remove="EmailTemplates/**/*.html" />
    <None Remove="EmailTemplates/**/*.html" />
    <Content Include="EmailTemplates/**/*.html" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- Feature 030: bundled GeoNames cities500 seed (regenerate with Data/Seed/regenerate-cities500.mjs). -->
    <Content Include="Data/Seed/cities500.seed.tsv.gz" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Remove="Data/Seed/regenerate-cities500.mjs" />
    <!-- The raw GeoNames downloads the regeneration script consumes are transient and huge
         (cities500.txt is ~40 MB). They are gitignored, but a local regeneration leaves them in
         the source tree, where the SDK's default content glob would publish them into the image. -->
    <Content Remove="Data/Seed/cities500.txt;Data/Seed/cities500.zip;Data/Seed/countryInfo.txt;Data/Seed/admin1CodesASCII.txt" />
    <None Remove="Data/Seed/cities500.txt;Data/Seed/cities500.zip;Data/Seed/countryInfo.txt;Data/Seed/admin1CodesASCII.txt" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Asp.Versioning.Mvc" Version="10.0.1" />
    <PackageReference Include="Asp.Versioning.Mvc.ApiExplorer" Version="10.0.1" />
    <PackageReference Include="AspNetCore.HealthChecks.NpgSql" Version="9.0.0" />
    <!-- Feature 035 (#97): media bytes live in object storage, not Postgres. Azurite emulates the
         same REST API locally and in tests, so local/Dev/Prod run one code path (Principle V).
         Microsoft.Extensions.Azure supplies the DI registration AND the transport hook that lets
         the client inherit the shared 028 resilience pipeline — see specs/035 research §3 for why
         the SDK's own retry is switched off rather than layered. Behind IMediaStore, so swappable. -->
    <PackageReference Include="Azure.Storage.Blobs" Version="12.29.2" />
    <PackageReference Include="Microsoft.Extensions.Azure" Version="1.14.1" />
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
    <!-- Feature 055 — Web Push (VAPID + RFC 8291 message encryption). The LOW-LEVEL package only:
         its companion Lib.AspNetCore.WebPush registers its own internal named HttpClient and its
         AddPushServiceClient returns IServiceCollection, not IHttpClientBuilder, so the shared
         resilience pipeline could not be chained onto it (constitution VII). PushServiceClient
         takes an HttpClient, so it wires as an ordinary typed client instead — see Program.cs.
         On .NET 10 this resolves the net6.0 asset, whose only dependency is
         Lib.Net.Http.EncryptedContentEncoding — so this package adds exactly one transitive.
         (BouncyCastle DOES show up when listing transitive packages, but it arrives via
         MailKit then MimeKit and predates this reference. This package pulls it only on its
         net451/netstandard2.0 assets, which .NET 10 never resolves.) -->
    <PackageReference Include="Lib.Net.Http.WebPush" Version="3.3.1" />
    <PackageReference Include="MailKit" Version="4.18.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
    <!-- GH #250: the Data Protection key ring lives in Postgres so every replica shares it and it
         survives restarts. First-party, same release train as the other AspNetCore packages. -->
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.StackExchangeRedis" Version="10.0.12" />
    <!-- Pin Microsoft.OpenApi above the transitive 2.0.0 that AspNetCore.OpenApi 10.0.10
         drags in, which is vulnerable to GHSA-v5pm-xwqc-g5wc (circular-schema DoS,
         fixed in 2.7.5). Must stay on the 2.x major: AspNetCore.OpenApi 10.x (net10.0)
         depends on Microsoft.OpenApi 2.x, and its source generator assigns to
         IOpenApiMediaType.Example, which became read-only in 3.x (build error CS0200).
         Moving to 3.x requires AspNetCore.OpenApi 11.x / .NET 11. -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.12.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.12" />
    <!-- Outbound HTTP resilience (feature 028 / constitution Principle VII). This is Polly v8
         packaged as a DelegatingHandler; every typed client opts in via AddJuggerHubResilience. -->
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.10.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.17.6" />
    <!-- Feature 034 (#98): server-side image processing (decode/guard/resize/strip/re-encode).
         Pure-managed (no native binary) so behavior is identical across local/Dev/Prod.
         First imaging dependency — deliberately supersedes the 003-profile "no new NuGet
         packages" bar (recorded drift). Behind IImageProcessor so it stays swappable.
         Stays on 3.x: 4.0.0 enforces the Six Labors license at BUILD time and fails with
         "No Six Labors license found" unless $(SixLaborsLicenseKey)/$(SixLaborsLicenseFile)
         or a sixlabors.lic is present. Apache-2.0 likely qualifies for the free OSS tier,
         but taking 4.x means obtaining a key and plumbing it into CI *and* the Docker
         build (dotnet publish runs in-image) — a licensing decision, not a version bump. -->
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
  </ItemGroup>

</Project>
