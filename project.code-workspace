{
  // One Explorer root per area. "Repo" holds everything else at the repository root: root files
  // (README, CLAUDE.md, DESIGN.md, compose files, …) plus the rarely touched tooling folders
  // (.claude, .github, .specify, scripts, wireframes, …). The areas below are hidden inside it by
  // `files.exclude` further down, so nothing is listed twice.
  //
  // Keep "Repo" FIRST. Tools that are not multi-root aware fall back to the first folder, and they
  // expect the repository root — e.g. `nxConsole.nxWorkspacePath: "frontend"` below is resolved
  // against it. Everything in this file that needs a path names its folder explicitly
  // (`${workspaceFolder:Repo}`): a bare `${workspaceFolder}` cannot be resolved in a multi-root
  // workspace and fails the launch config or task that uses it.
  "folders": [
    { "name": "Repo", "path": "." },
    { "name": "Backend", "path": "backend" },
    { "name": "Frontend", "path": "frontend" },
    { "name": "Infra", "path": "infra" },
    { "name": "Specs", "path": "specs" }
  ],
  "extensions": {
    "recommendations": [
      // AI assistant
      "anthropic.claude-code",

      // Backend — .NET 10 / C#
      "ms-dotnettools.csdevkit",
      "ms-dotnettools.csharp",

      // Frontend — Angular 21 + Nx + Tailwind
      "angular.ng-template",
      "nrwl.angular-console",
      "bradlc.vscode-tailwindcss",
      "dbaeumer.vscode-eslint",
      "esbenp.prettier-vscode",
      "ms-playwright.playwright",

      // Local stack — Docker Compose / Postgres
      "ms-azuretools.vscode-containers",
      "ms-ossdata.vscode-pgsql",

      // Infra — Terraform / AKS / Kubernetes
      "hashicorp.terraform",
      "ms-kubernetes-tools.vscode-kubernetes-tools",
      "redhat.vscode-yaml",

      // Tooling — PowerShell scripts, GitHub Actions, PRs/issues
      "ms-vscode.powershell",
      "github.vscode-github-actions",
      "github.vscode-pull-request-github"
    ]
  },
  "settings": {
    // Hides the areas that have their own root from "Repo" (which is rooted at "."). Patterns are
    // relative to EACH folder, so these only match at the repository root — none of the areas has a
    // top-level folder with one of these names; if one ever does, it disappears too. Search and
    // Quick Open inherit this list, so their results are not duplicated either.
    "files.exclude": {
      "backend": true,
      "frontend": true,
      "infra": true,
      "specs": true
    },
    "terminal.integrated.defaultProfile.windows": "PowerShell",
    // The profiles below that run repo-level commands (compose files, graphify-out) `Set-Location`
    // to the repository root first: in a multi-root workspace a new terminal opens in whichever
    // folder you pick, and `-f docker-compose.debug.yml` is resolved against that.
    "terminal.integrated.profiles.windows": {
      "PowerShell": {
        "source": "PowerShell",
        "icon": "terminal-powershell"
      },
      "Docker Compose Up": {
        "path": "pwsh.exe",
        "args": ["-NoExit", "-Command", "Set-Location '${workspaceFolder:Repo}'; docker compose up --build -d; docker compose logs -f"],
        "icon": "play",
        "color": "terminal.ansiGreen"
      },
      "Docker Compose Debug": {
        "path": "pwsh.exe",
        "args": ["-NoExit", "-Command", "Set-Location '${workspaceFolder:Repo}'; docker compose -f docker-compose.yml -f docker-compose.debug.yml up --build -d; docker compose -f docker-compose.yml -f docker-compose.debug.yml logs -f"],
        "icon": "debug-alt",
        "color": "terminal.ansiYellow"
      },
      "Docker Compose + Spam Scoring": {
        "path": "pwsh.exe",
        "args": ["-NoExit", "-Command", "Set-Location '${workspaceFolder:Repo}'; docker compose --profile spam up --build -d; docker compose --profile spam logs -f"],
        "icon": "mail",
        "color": "terminal.ansiMagenta"
      },
      // Self-hosted Umami analytics (feature 033). Dashboard: http://localhost:3001 (admin/umami).
      //
      // UMAMI_WEBSITE_ID is set HERE rather than in .env on purpose. It is the whole tracker
      // switch — set, the frontend injects the tracker; unset, nothing is injected — and compose
      // cannot scope a variable to a profile, because the frontend service starts either way and
      // so never learns that `--profile analytics` was passed. Setting it in .env would therefore
      // also inject the tracker into a plain `docker compose up`, where Umami is not running, and
      // cost one failed background request per page load. Setting it in this terminal profile
      // scopes it by construction: analytics is on exactly when you launch it from here.
      //
      // The ID is a value we chose, not one Umami generated, and the stack provisions the matching
      // website row itself — so there is nothing to create in the dashboard and nothing to copy.
      "Docker Compose + Analytics": {
        "path": "pwsh.exe",
        "args": ["-NoExit", "-Command", "Set-Location '${workspaceFolder:Repo}'; $env:UMAMI_WEBSITE_ID='a1b2c3d4-0000-4000-8000-000000000033'; docker compose --profile analytics up --build -d; docker compose --profile analytics logs -f"],
        "icon": "pulse",
        "color": "terminal.ansiBlue"
      },
      // `--profile "*"` rather than naming profiles: `down` only removes containers belonging to
      // the profiles it is given, so `--profile spam down` left every analytics container running
      // and the network undeletable ("Resource is still in use"). The wildcard means this keeps
      // working when the next profile is added, instead of silently orphaning it too.
      "Docker Compose Down": {
        "path": "pwsh.exe",
        "args": ["-NoExit", "-Command", "Set-Location '${workspaceFolder:Repo}'; docker compose --profile \"*\" down"],
        "icon": "debug-stop",
        "color": "terminal.ansiRed"
      },
      // Tunnel to the in-cluster Postgres so the PostgreSQL extension (ms-ossdata.vscode-pgsql)
      // can connect to it at localhost:5433. Dev/Prod Postgres is ClusterIP-only and never
      // exposed beyond the cluster, so a port-forward is the only route in.
      //
      // 5433, not 5432: the local compose database already owns 5432 on the host, and a
      // collision would silently point you at the wrong database. Prints the current kube
      // context first — `juggerhub` is the namespace in EVERY environment, so the context is
      // the only thing telling you whether this tunnel lands in Dev or Prod.
      //
      // Requires credentials once per cluster:
      //   az aks get-credentials --resource-group rg-juggerhub-dev --name aks-juggerhub-dev
      "Port-forward: Dev Postgres": {
        "path": "pwsh.exe",
        "args": ["-NoExit", "-Command", "kubectl config current-context; kubectl -n juggerhub port-forward svc/postgres 5433:5432"],
        "icon": "plug",
        "color": "terminal.ansiCyan"
      },
      "Graphify: View Graph": {
        "path": "pwsh.exe",
        "args": ["-NoExit", "-Command", "Set-Location '${workspaceFolder:Repo}'; Start-Process \"$PWD/graphify-out/graph.html\""],
        "icon": "graph",
        "color": "terminal.ansiGreen"
      },
      "Graphify: Rebuild + View": {
        "path": "pwsh.exe",
        "args": ["-NoExit", "-Command", "Set-Location '${workspaceFolder:Repo}'; graphify update .; Start-Process \"$PWD/graphify-out/graph.html\""],
        "icon": "sync",
        "color": "terminal.ansiGreen"
      }
    },
    "nxConsole.nxWorkspacePath": "frontend",
    // Files copied into every new git worktree (Source Control → ... → Worktrees → Create Worktree).
    //
    // Worktrees share the object store, not the working tree, so a new one starts with tracked
    // files only — anything in .gitignore is simply absent. Both entries below are gitignored and
    // both fail quietly rather than loudly if missing: without `.env` the compose stack comes up
    // against the wrong (default) values instead of refusing to start, and without
    // `settings.local.json` the agent re-prompts for permissions it was already granted.
    //
    // `node_modules` is deliberately NOT here. The docs offer it as an example, but copying a
    // few hundred MB per worktree is slower than the `npm ci` it replaces — run that instead.
    // Note this setting applies when the worktree is CREATED, so create them from a window with
    // this workspace open; a bare folder window never reads it.
    "git.worktreeIncludeFiles": [".env", ".claude/settings.local.json"]
  },
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "name": ".NET Core Attach (Docker)",
        "type": "coreclr",
        "request": "attach",
        "processId": "${command:pickRemoteProcess}",
        "pipeTransport": {
          "pipeProgram": "docker",
          "pipeArgs": ["exec", "-i", "juggerhub-backend"],
          "debuggerPath": "/remote_debugger/vsdbg",
          "pipeCwd": "${workspaceFolder:Repo}",
          "quoteArgs": false
        },
        "sourceFileMap": {
          "/src": "${workspaceFolder:Backend}"
        }
      },
      {
        "name": "Node.js Attach (Docker)",
        "type": "node",
        "request": "attach",
        "port": 9229,
        "address": "localhost",
        "localRoot": "${workspaceFolder:Frontend}",
        "remoteRoot": "/app",
        "sourceMaps": true,
        "restart": true
      },
      {
        "name": "Chrome: Frontend",
        "type": "chrome",
        "request": "launch",
        "url": "http://localhost:3000",
        "webRoot": "${workspaceFolder:Frontend}"
      }
    ],
    "compounds": [
      {
        "name": "Full Stack Debug",
        "configurations": [".NET Core Attach (Docker)", "Node.js Attach (Docker)", "Chrome: Frontend"]
      }
    ]
  },
  "tasks": {
    "version": "2.0.0",
    // Every task below runs repo-level commands (compose files, graphify), so they all run from
    // the repository root rather than whichever folder a workspace-level task would default to.
    "options": { "cwd": "${workspaceFolder:Repo}" },
    "tasks": [
      {
        "label": "Docker Compose Up",
        "type": "shell",
        "command": "docker compose up --build -d",
        "group": "build",
        "presentation": {
          "reveal": "always",
          "panel": "new"
        }
      },
      {
        "label": "Docker Compose Debug",
        "type": "shell",
        "command": "docker compose -f docker-compose.yml -f docker-compose.debug.yml up --build -d",
        "group": "build",
        "presentation": {
          "reveal": "always",
          "panel": "new"
        }
      },
      {
        "label": "Docker Compose + Spam Scoring",
        "detail": "Start the stack with the opt-in SpamAssassin daemon so Mailpit's Spam Analysis panel works",
        "type": "shell",
        "command": "docker compose --profile spam up --build -d",
        "group": "build",
        "problemMatcher": [],
        "presentation": {
          "reveal": "always",
          "panel": "new"
        }
      },
      {
        "label": "Docker Compose Down",
        "type": "shell",
        "command": "docker compose --profile spam down",
        "group": "build",
        "presentation": {
          "reveal": "always",
          "panel": "new"
        }
      },
      {
        "label": "Docker Compose Logs",
        "type": "shell",
        "command": "docker compose logs -f",
        "group": "build",
        "presentation": {
          "reveal": "always",
          "panel": "new"
        }
      },
      {
        "label": "Docker Compose Down + Drop DB Volume",
        "detail": "Stop the stack and delete the Postgres volume (fresh database next `up`)",
        "type": "shell",
        "command": "docker compose down -v",
        "group": "build",
        "problemMatcher": [],
        "presentation": {
          "reveal": "always",
          "panel": "new"
        }
      },
      {
        "label": "Test: Backend (xUnit + Testcontainers)",
        "detail": "Run backend integration tests in a container (Docker must be running — Testcontainers spins up a sibling Postgres)",
        "type": "shell",
        "command": "docker compose -f docker-compose.yml -f docker-compose.test.yml run --rm backend-test",
        "group": "test",
        "problemMatcher": [],
        "presentation": {
          "reveal": "always",
          "panel": "new"
        }
      },
      {
        "label": "Test: Frontend (Jest)",
        "detail": "Run frontend unit tests in a container",
        "type": "shell",
        "command": "docker compose -f docker-compose.yml -f docker-compose.test.yml run --rm frontend-test",
        "group": "test",
        "problemMatcher": [],
        "presentation": {
          "reveal": "always",
          "panel": "new"
        }
      },
      {
        "label": "Test: E2E (Playwright)",
        "detail": "Run Playwright e2e (desktop + mobile) in a container; dependencies (frontend/backend/db/mailpit) start automatically",
        "type": "shell",
        "command": "docker compose -f docker-compose.yml -f docker-compose.test.yml run --rm playwright",
        "group": "test",
        "problemMatcher": [],
        "presentation": {
          "reveal": "always",
          "panel": "new"
        }
      },
      {
        "label": "Lint: Frontend (CI parity)",
        "detail": "Run the same lint gate as CI (`nx run-many -t lint`) in a container",
        "type": "shell",
        "command": "docker compose -f docker-compose.yml -f docker-compose.test.yml run --rm --entrypoint npx frontend-test nx run-many -t lint",
        "group": "test",
        "problemMatcher": [],
        "presentation": {
          "reveal": "always",
          "panel": "new"
        }
      },
      {
        "label": "Install vsdbg",
        "type": "shell",
        "command": "docker exec -i juggerhub-backend bash -c 'curl -sSL https://aka.ms/getvsdbgsh | bash /dev/stdin -v latest -l /remote_debugger'",
        "group": "build",
        "presentation": {
          "reveal": "always",
          "panel": "new"
        }
      },
      {
        "label": "🕸️ Graphify: View Graph",
        "detail": "Open the interactive knowledge graph (graphify-out/graph.html) in your browser",
        "type": "shell",
        "command": "xdg-open \"${workspaceFolder:Repo}/graphify-out/graph.html\"",
        "windows": {
          "command": "Start-Process \"${workspaceFolder:Repo}/graphify-out/graph.html\""
        },
        "osx": {
          "command": "open \"${workspaceFolder:Repo}/graphify-out/graph.html\""
        },
        "icon": { "id": "graph", "color": "terminal.ansiGreen" },
        "problemMatcher": [],
        "presentation": { "reveal": "silent", "panel": "shared", "close": true }
      },
      {
        "label": "🕸️ Graphify: Rebuild + View Graph",
        "detail": "Run `graphify update .` (fast, no-LLM) then open the refreshed graph",
        "type": "shell",
        "command": "graphify update . ; xdg-open \"${workspaceFolder:Repo}/graphify-out/graph.html\"",
        "windows": {
          "command": "graphify update . ; Start-Process \"${workspaceFolder:Repo}/graphify-out/graph.html\""
        },
        "osx": {
          "command": "graphify update . ; open \"${workspaceFolder:Repo}/graphify-out/graph.html\""
        },
        "icon": { "id": "sync", "color": "terminal.ansiGreen" },
        "problemMatcher": [],
        "presentation": { "reveal": "always", "panel": "dedicated" }
      }
    ]
  }
}
